# Set in Vercel project env (or .env.local) so social cards unfurl with
# absolute URLs. Without it the og tags fall back to relative = no rich card.
VITE_SITE_URL=https://your-domain

# YouTube search for the jukebox. NOT VITE_ prefixed, deliberately: Vite
# embeds anything VITE_ verbatim into the client bundle and this repository is
# public, so a key there is a key anyone can read and drain. This one is read
# by /api/yt-search on the server and never reaches the browser.
#
# Get one at console.cloud.google.com -> APIs & Services -> Credentials, with
# "YouTube Data API v3" enabled. Restrict it to that API. Free quota is 10,000
# units/day and a search costs 100, so ~100 searches/day; the endpoint caches
# on Vercel's edge for an hour, which is most of the budget back.
#
# Unset, search still works through a keyless mirror. Those are unreliable
# (measured 2026-09-14: five of six public instances dead or CORS-blocked), so
# set this for anything you actually rely on.
YT_API_KEY=
